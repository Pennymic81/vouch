# Copy to .env and fill in.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# SQLite file for local development (moves to hosted Postgres before going live)
DATABASE_URL=file:vouch.db

# QA reviewers (step 6): Vouch staff who check milestones. Comma-separated emails;
# "*@yourdomain.com" allows everyone on a domain. Reviewers sign up like any user.
REVIEWER_EMAILS=
# Days an owner has to approve after QA passes, before it's approved automatically
REVIEW_WINDOW_DAYS=5

# AI plan writing (step 4). Get a key at https://console.anthropic.com
# Without a key the app still works; the "Write my plan with AI" panel shows as unavailable.
ANTHROPIC_API_KEY=
# Optional: which model writes plans
ANTHROPIC_MODEL=claude-sonnet-5-5

# Payments (step 7) — Paystack. Get keys at https://dashboard.paystack.com/#/settings/developers
# Use the TEST secret key (sk_test_…) until you're ready to take real money.
# Without a key, payments are simulated.
PAYSTACK_SECRET_KEY=
# Currency for new projects and developer rates (NGN, USD, GHS, KES or ZAR — must be enabled on your Paystack account)
APP_CURRENCY=NGN
# Vouch's fee, taken from each developer payout (percent)
PLATFORM_FEE_PERCENT=10
